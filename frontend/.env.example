# Online mode uses this public Space only after the user sends a message.
VITE_MEDICAL_SPACE=Pablo305/offline-medical-assistant

# Optional browser model: MUST be MLC format, with a matching compiled WASM.
# Raw transformers/bitsandbytes models cannot be used by WebLLM.
# VITE_WEBLLM_MODEL_URL=https://huggingface.co/YOUR_ACCOUNT/YOUR_MLC_MODEL
# VITE_WEBLLM_MODEL_ID=kit-ai-medical-mlc
# VITE_WEBLLM_MODEL_LIB=https://YOUR_HOST/matching-model-webgpu.wasm

# Optional external services (unset = bundled guides + browser speech).
# VITE_BACKEND_URL=https://your-backend.example.com
